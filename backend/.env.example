# Backend Configuration
APP_NAME="WhatsApp OTP Service"
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Security: Shared HMAC Secret & API Key
# Replace these with strong production secrets!
SECRET_KEY="super-secret-hmac-key-change-in-production-123456"
API_KEY="platform-api-key-9876543210"

# Header Security Mode: "hmac", "apikey", or "both"
SECURITY_MODE="none"

# Header Names
SIGNATURE_HEADER="X-Signature"
TIMESTAMP_HEADER="X-Timestamp"
API_KEY_HEADER="X-API-Key"
MAX_TIMESTAMP_DRIFT_SECONDS=300

# OTP Settings
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5

# Baileys WhatsApp Gateway URL & Internal Token
BAILEYS_GATEWAY_URL="http://127.0.0.1:3001"
BAILEYS_INTERNAL_TOKEN="internal-baileys-secret-token-abcdef"

# Brand Display Name in WhatsApp
BRAND_NAME="Codex Academy"
